# Dominio definitivo, sin barra final. Activa canonical, Open Graph con URL, sitemap y robots con Sitemap.
# SITE_URL=https://tu-dominio.com

# Pon "true" solo cuando una red publicitaria esté aprobada y configurada. Por defecto no hay anuncios.
# PUBLIC_ADS_ENABLED=false

# Correo que se mostrará en /contact/. Si se deja vacío, la página indica que aún no hay canal configurado.
# PUBLIC_CONTACT_EMAIL=contacto@tu-dominio.com
