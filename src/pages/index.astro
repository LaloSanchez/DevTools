---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools } from '../content/tools';

const categories = [...new Set(tools.map((t) => t.category))];
---

<BaseLayout
  title="DevTools — Herramientas gratuitas para desarrolladores"
  description="Formateadores, comparadores y convertidores gratuitos para desarrolladores. Funcionan en tu navegador, sin registro y sin enviar tus datos."
>
  <div class="mx-auto max-w-5xl px-4 py-12">
    <section>
      <h1 class="text-3xl font-bold sm:text-4xl">Herramientas gratuitas para desarrolladores</h1>
      <p class="mt-3 max-w-2xl text-lg text-slate-600 dark:text-slate-400">
        Formatea JSON, compara textos, ordena SQL y convierte fechas. Todo corre en tu navegador: sin registro y sin enviar lo que escribes.
      </p>
      <a href="/tools/" class="mt-6 inline-block rounded-lg bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-700">
        Ver todas las herramientas
      </a>
    </section>

    <section class="mt-12" aria-labelledby="destacadas">
      <h2 id="destacadas" class="text-xl font-semibold">Herramientas destacadas</h2>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2">
        {tools.map((t) => <li><ToolCard tool={t} /></li>)}
      </ul>
    </section>

    <section class="mt-12" aria-labelledby="categorias">
      <h2 id="categorias" class="text-xl font-semibold">Categorías</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {categories.map((c) => (
          <li class="rounded-full border border-slate-200 px-3 py-1 text-sm dark:border-slate-800">{c}</li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
