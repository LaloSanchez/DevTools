---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools, toolUrl } from '../content/tools';

const categories = [...new Set(tools.map((t) => t.category))];
const featured = tools.find((t) => t.featured && t.available);
const others = tools.filter((t) => t !== featured);
---

<BaseLayout
  title="DevTools — Herramientas gratuitas para desarrolladores"
  description="Probador de APIs, formateadores, comparadores y convertidores gratuitos para desarrolladores. Funcionan en tu navegador, sin registro."
>
  <div class="mx-auto max-w-5xl px-4 py-12">
    <section>
      <h1 class="text-3xl font-bold sm:text-4xl">Herramientas gratuitas para desarrolladores</h1>
      <p class="mt-3 max-w-2xl text-lg text-slate-600 dark:text-slate-400">
        Prueba APIs, formatea JSON, compara textos, ordena SQL y convierte fechas. Todo corre en tu navegador, sin registro y sin pasar por nuestros servidores.
      </p>
      <a href="/tools/" class="mt-6 inline-block rounded-lg bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-700">
        Ver todas las herramientas
      </a>
    </section>

    {
      featured && (
        <section class="mt-12" aria-labelledby="principal">
          <a
            href={toolUrl(featured)}
            class="block rounded-xl border-2 border-indigo-500 bg-indigo-50 p-6 transition-colors hover:bg-indigo-100 dark:bg-indigo-950/40 dark:hover:bg-indigo-950"
          >
            <p class="text-xs font-medium uppercase tracking-wide text-indigo-700 dark:text-indigo-400">Herramienta principal · {featured.category}</p>
            <h2 id="principal" class="mt-1 text-2xl font-bold">{featured.name}</h2>
            <p class="mt-2 max-w-2xl text-slate-700 dark:text-slate-300">{featured.description}</p>
            <span class="mt-4 inline-block font-medium text-indigo-700 dark:text-indigo-400">Abrir la herramienta →</span>
          </a>
        </section>
      )
    }

    <section class="mt-12" aria-labelledby="destacadas">
      <h2 id="destacadas" class="text-xl font-semibold">{featured ? 'Más herramientas' : 'Herramientas destacadas'}</h2>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2">
        {others.map((t) => <li><ToolCard tool={t} /></li>)}
      </ul>
    </section>

    <section class="mt-12" aria-labelledby="categorias">
      <h2 id="categorias" class="text-xl font-semibold">Categorías</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {categories.map((c) => (
          <li class="rounded-full border border-slate-200 px-3 py-1 text-sm dark:border-slate-800">{c}</li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
