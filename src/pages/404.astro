---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada — DevTools" description="La página que buscas no existe." noindex>
  <div class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold">Página no encontrada</h1>
    <p class="mt-3 text-slate-700 dark:text-slate-300">No encontramos lo que buscabas. Prueba desde el <a class="text-indigo-700 underline dark:text-indigo-400" href="/tools/">listado de herramientas</a>.</p>
  </div>
</BaseLayout>
