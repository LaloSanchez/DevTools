---
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/tools/', label: 'Herramientas' },
];
const current = Astro.url.pathname;
---

<header class="border-b border-slate-200 dark:border-slate-800">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="flex items-center gap-2 text-lg font-bold">
      <img src="/favicon.svg" alt="" width="24" height="24" />
      DevTools
    </a>
    <nav aria-label="Principal" class="flex items-center gap-1 sm:gap-3">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={current === l.href ? 'page' : undefined}
            class="rounded px-2 py-1 text-sm text-slate-600 hover:text-slate-900 aria-[current=page]:font-semibold aria-[current=page]:text-indigo-600 dark:text-slate-300 dark:hover:text-white dark:aria-[current=page]:text-indigo-400"
          >
            {l.label}
          </a>
        ))
      }
      <button
        id="theme-toggle"
        type="button"
        aria-label="Cambiar tema claro u oscuro"
        class="rounded p-2 text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800"
      >
        <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
        <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
    </nav>
  </div>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {
      // Sin almacenamiento disponible: el tema solo dura esta visita.
    }
  });
</script>
